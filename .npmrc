# package-lock отключён намеренно.
# ПРЕДПОЛОЖЕНИЕ (точная причина не зафиксирована, восстановлено по истории git):
# Мы разрабатываем на macOS (darwin), а CI (GitHub Pages / Actions) — на Linux.
# Next.js/sharp тянут платформо-специфичные optional-зависимости (@next/swc-*, @img/sharp-*).
# lockfile, сгенерированный на маке, содержит только darwin-бинарники, поэтому на Linux
# `npm ci` молча пропускает нужный бинарник и сборка падает: "Cannot find module @next/swc-linux-x64-gnu".
# Без lockfile npm install каждый раз резолвит зависимости под текущую платформу — сборка проходит.
# Подробнее: https://github.com/npm/cli/issues/4828
# Поэтому в workflow используется `npm install`, а не `npm ci`.
package-lock=false
